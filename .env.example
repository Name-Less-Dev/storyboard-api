# Copy to .env and fill in. Never commit .env.

# Storyboard generator: "fake" (default, deterministic, no key needed) or "llm" (Gemini).
GENERATOR=fake

# Required only when GENERATOR=llm. Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=20

# SQLAlchemy URL. Default: SQLite file in the project root.
# Postgres example: postgresql+psycopg://user:password@localhost:5432/storyboard
DATABASE_URL=sqlite:///./storyboard.db
